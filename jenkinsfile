pipeline {
    agent any

    environment {
        NODE_ENV = 'test'
        ALLURE_RESULTS = './allure-results'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('./tests'){
                    npm ci
                }
            }
        }
        stage('Run Playwright Tests') {
            steps {
                dir('./tests'){
                    npm run testCase
                }
                
            }
        }
        stage('Allure Report') {
            steps {
                dir('./tests'){
                    npm run generate
                    npm run open
                }
            }
        }
    }

    post {
        always {
            echo 'Completed...'
        }
    }
}