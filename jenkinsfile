pipeline {
    agent any

    environment {
        NODE_ENV = 'test'
        ALLURE_RESULTS = './allure-results'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                npm ci
            }
        }
        stage('Run Playwright Tests') {
            steps {
                npx playwright test
            }
        }
        stage('Allure Report') {
            steps {
                npx allure generate allure-results --clean -o allure-report
                npx allure open allure-report
            }
        }
    }

    post {
        always {
            echo 'Completed...'
        }
    }
}