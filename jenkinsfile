pipeline {
    agent any
    stages {
        stage('Install Dependencies') {
            steps {
                dir('./tests') {
                    npm ci
                    npx playwright test
                    npx allure generate ./allure-results -o ./allure-report
                }
            }
        }
        stage('Publish Allure Report') {
            steps {
                dir('./tests') {
                    npx allure serve ./allure-results
                }
            }
        }
    }
}
