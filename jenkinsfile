pipeline {
    agent any

    environment {
        sh_ENV = 'test'
        ALLURE_RESULTS = './allure-results'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('./tests') {
                    npm ci
                    npx playwright test
                    npx allure open allure-report
                    npx allure generate allure-results --clean -o allure-report
                }
            }
        }
    }

    post {
        always {
            echo 'Completed...'
        }
    }
}