pipeline {
    agent any

    environment {
        sh_ENV = 'test'
        ALLURE_RESULTS = './allure-results'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('./tests') {
                    sh 'npm ci'
                }
            }
        }
        stage('Run Playwright Tests') {
            steps {
                dir('./tests') {
                    sh 'npx playwright test'
                }
            }
        }
        stage('Allure Report') {
            steps {
                dir('./tests') {
                    sh 'npx allure generate allure-results --clean -o allure-report'
                    sh 'npx allure open allure-report'
                }
            }
        }
    }

    post {
        always {
            echo 'Completed...'
        }
    }
}